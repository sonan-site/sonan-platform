# انسخ هذا الملف إلى .env واملأ القيم.
# مخطط lib/env.ts يفحصها عند الإقلاع، والنقص يُفشل التشغيل فوراً.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# لا يُقرأ إلا في lib/db/service-role.ts — واستيراده من العميل يفشل بناءً.
SUPABASE_SERVICE_ROLE_KEY=

# اتصال مباشر بالقاعدة — لاختبارات القاعدة وحدها (pnpm test:db).
# من لوحة Supabase: Project Settings > Database > Connection string > URI
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# ── أدوات التطوير فقط. لا يقرؤها التطبيق ولا مخطط lib/env.ts ──


# رمز وصول شخصي، لتوليد الأنواع بلا Docker.
# من: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

{
  "name": "sonan-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "next dev",
    "build": "next build",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "lint": "eslint .",
    "verify": "tsc --noEmit && eslint . && vitest run",
    "db:reset": "supabase db reset --db-url \"$SUPABASE_DB_URL\"",
    "db:types": "supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" > lib/db/database.types.ts",
    "db:push": "supabase db push --db-url \"$SUPABASE_DB_URL\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "pg": "8.23.0",
    "supabase": "2.115.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
